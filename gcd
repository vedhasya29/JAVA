public class main
{
    public static void main(String[] args)
    {
        int a = 60;
        int b = 40;

        int gcd = gcd(a, b);

        System.out.println("GCD is " + gcd);
    }

    public static int gcd(int a, int b)
    {
        while(b != 0)
        {
            int rem = a % b;
            a = b;
            b = rem;
        }

        return a;
    }
}
