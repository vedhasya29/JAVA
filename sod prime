public class main
{
    public static void main(String[]args)
    {
        int s;
        for(int i=100;i<=1000;i++)
        {
            s=sod(i);
            if(prime(i) && prime(s))
            System.out.print(i+ "");
        }
    }
    public static int sod(int a)
    {
        int s=0;
        while(a>0)
    {
        s=s+(a%10);
        a=a/10;
    }
    return s;
}
public static boolean prime(int i)
{
    if(i==0)
    return false;
    for(int j=2;j<i;j++)
    {
        if(i%j==0)
        return false;
    }
    return true;
    }
}
